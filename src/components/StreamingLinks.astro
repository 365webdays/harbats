---
import { platforms, platformOrder } from '../data/platforms';

// Artist-level streaming links (distinct from the per-track links popover in
// TrackSection.astro). Glyph data lives in src/data/platforms.ts.
---

<nav class="streaming-links" aria-label="Streaming platforms">
  <p class="streaming-links-eyebrow">Kitakits!</p>
  <div class="streaming-links-icons">
    {platformOrder.map((key) => {
      const platform = platforms[key];
      return (
        <a
          class="streaming-links-link"
          href={platform.artistUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Listen to Harbats on ${platform.name}`}
        >
          <svg viewBox={platform.viewBox} aria-hidden="true">
            {platform.paths.map((d) => (
              <path d={d} />
            ))}
          </svg>
        </a>
      );
    })}
  </div>
</nav>
