---
import { tracks } from '../data/tracks';
import StreamingLinks from './StreamingLinks.astro';

const [defaultTrack] = tracks;
---

<aside class="media-player" style={`--track-accent: var(--color-${defaultTrack.accentColor})`}>
  <div class="media-player-current">
    <div class="media-player-cover">
      <img
        class="media-player-art"
        data-role="art"
        src={defaultTrack.artworkUrl}
        alt=""
        width="44"
        height="44"
        hidden={!defaultTrack.artworkUrl}
      />
      <button
        class="media-player-toggle"
        type="button"
        aria-label="Play"
        aria-pressed="false"
        disabled={!defaultTrack.audioUrl}
        data-role="toggle"
      >
        <svg class="media-player-icon" data-role="icon-play" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        <svg class="media-player-icon is-hidden" data-role="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
        </svg>
      </button>
    </div>
    <div class="media-player-meta">
      <p class="media-player-title" data-role="title">{defaultTrack.title}</p>
      <p class="media-player-eyebrow" data-role="eyebrow">{defaultTrack.releaseDate}</p>
    </div>
  </div>

  <ul class="media-player-list" data-role="list">
    {tracks.map((track) => (
      <li>
        <a
          href={`#${track.slug}`}
          class="media-player-list-link"
          data-slug={track.slug}
          data-title={track.title}
          data-eyebrow={track.releaseDate}
          data-audio={track.audioUrl}
          data-art={track.artworkUrl}
          data-accent={track.accentColor}
          aria-current={track.slug === defaultTrack.slug ? 'true' : undefined}
          aria-disabled={track.audioUrl ? undefined : 'true'}
        >
          {track.title}
        </a>
      </li>
    ))}
  </ul>

  <StreamingLinks />

  <div class="who-we-are-clip">
    <div class="who-we-are-slide">
      <div
        class="who-we-are"
        id="who-we-are"
        data-role="about-panel"
        data-lenis-prevent
        aria-hidden="true"
        aria-labelledby="who-we-are-eyebrow"
      >
        <p class="who-we-are-eyebrow" id="who-we-are-eyebrow">The Band</p>
        <p class="who-we-are-body">
          Harbats, the enigmatic band hailing from the vibrant streets of Manila,
          Philippines, and bringing their own flavor to the iconic Manila sound.
        </p>
        <p class="who-we-are-body">
Don't let their relaxed demeanor fool you. They'll take the stage for an audience of one or a packed house with equal passion.
        </p>
        <p class="who-we-are-body">
          Armed with infectious grooves, catchy melodies, and soulful vocals,
          Harbats' music will take you on a journey.
        </p>
        <!-- TODO: confirm the full member roster. -->
        <ul class="who-we-are-members">
          <li class="who-we-are-member">
            <img
              src="/assets/img/band/about_berninoy_bw.jpg"
              alt="Bernie Asis"
              loading="lazy"
              onerror="this.style.display='none'"
            />
            <span class="who-we-are-member-name">Bernie Asis</span>
            <p class="who-we-are-member-bio">
              The Illicit Lovechild of a jukebox queen and karaoke rebel. Raised
              on crooners, he found his groove as a crow wooing pigeons. His
              lyrics? Like confetti in a bar brawl. His music? May inspire
              spontaneous dancing and uncontrollable cravings for champorado.
            </p>
          </li>
          <li class="who-we-are-member">
            <img
              src="/assets/img/band/about_maytul_bw.jpg"
              alt="Michael Peralta"
              loading="lazy"
              onerror="this.style.display='none'"
            />
            <span class="who-we-are-member-name">Michael Peralta</span>
            <p class="who-we-are-member-bio">
              His musical misadventures started with his parents' Akai vinyl
              player and a Michael Franks LP. He dabbled in piano and
              successfully failed in achieving virtuoso-level. He overcompensates
              by playing drums. He's still (and will always be) a rabid Spice
              Girls fan.
            </p>
          </li>
        </ul>
        <p class="who-we-are-body">
          From the hard-hitting beats of &ldquo;Meryendabol&rdquo; to the
          melancholic strains of &ldquo;Hansolo&rdquo; and the soulful melodies
          of &ldquo;Kumot,&rdquo; their songs paint a vivid picture of love,
          life, and the absurdities of relationships.
        </p>
        <p class="who-we-are-body">
          Proudly written in Filipino, their lyrics delve into the complexities
          of human emotions, often blowing them out of proportion yet always
          holding a grain of truth.
        </p>
        <p class="who-we-are-body">
          Formed in 2014 by Bernie Asis and Mike Peralta, the band's lineup
          includes Bernie on vocals and bass, Mike on drums and keys. Each
          member brings their own unique talents and influences to the table,
          contributing to the band's diverse and dynamic sound.
        </p>
      </div>
      <button
        class="media-player-tab"
        type="button"
        aria-expanded="false"
        aria-controls="who-we-are"
        data-role="about-tab"
        aria-label="The Band"
      >
        <span class="media-player-tab-label" aria-hidden="true">The Band</span>
        <span class="media-player-tab-icon" aria-hidden="true">✕</span>
      </button>
    </div>
  </div>

  <audio data-role="audio" preload="metadata"></audio>
</aside>

<script>
  import { getSettledScrollTarget } from '../lib/scrollPhases';
  import { smoothScrollTo } from '../lib/smoothScroll';

  interface TrackLinkData {
    slug: string;
    title: string;
    eyebrow: string;
    audio: string;
    art: string;
    accent: string;
  }

  function init(): void {
    const playerRef = document.querySelector<HTMLElement>('.media-player');
    if (!playerRef) return;
    const player = playerRef;

    const audioRef = player.querySelector<HTMLAudioElement>('[data-role="audio"]');
    const artRef = player.querySelector<HTMLImageElement>('[data-role="art"]');
    const toggleRef = player.querySelector<HTMLButtonElement>('[data-role="toggle"]');
    const iconPlayRef = player.querySelector<SVGElement>('[data-role="icon-play"]');
    const iconPauseRef = player.querySelector<SVGElement>('[data-role="icon-pause"]');
    const titleRef = player.querySelector<HTMLElement>('[data-role="title"]');
    const eyebrowRef = player.querySelector<HTMLElement>('[data-role="eyebrow"]');
    const links = Array.from(
      player.querySelectorAll<HTMLAnchorElement>('.media-player-list-link')
    );

    if (!audioRef || !artRef || !toggleRef || !iconPlayRef || !iconPauseRef || !titleRef || !eyebrowRef || links.length === 0) {
      return;
    }

    // Re-bind to non-null consts: the narrowing above doesn't persist into
    // the nested closures (loadTrack, setPlayingState, event handlers) below,
    // but a `const` typed as non-null at declaration does.
    const audio = audioRef;
    const art = artRef;
    const toggle = toggleRef;
    const iconPlay = iconPlayRef;
    const iconPause = iconPauseRef;
    const titleEl = titleRef;
    const eyebrowEl = eyebrowRef;

    let currentSlug = '';

    function dataFor(link: HTMLAnchorElement): TrackLinkData {
      return {
        slug: link.dataset.slug ?? '',
        title: link.dataset.title ?? '',
        eyebrow: link.dataset.eyebrow ?? '',
        audio: link.dataset.audio ?? '',
        art: link.dataset.art ?? '',
        accent: link.dataset.accent ?? 'mango',
      };
    }

    function loadTrack(slug: string, { scroll = false, autoplay = false } = {}): void {
      const link = links.find((l) => l.dataset.slug === slug);
      if (!link) return;
      const data = dataFor(link);

      if (currentSlug !== data.slug) {
        currentSlug = data.slug;
        titleEl.textContent = data.title;
        eyebrowEl.textContent = data.eyebrow;
        player.style.setProperty('--track-accent', `var(--color-${data.accent})`);

        if (data.art) {
          art.src = data.art;
          art.hidden = false;
        } else {
          art.hidden = true;
          art.removeAttribute('src');
        }

        if (data.audio) {
          audio.src = data.audio;
          toggle.disabled = false;
          if (autoplay) audio.play().catch(() => {});
        } else {
          // Track has no audio file yet — stop/unload whatever was playing
          // and disable the play button rather than trying to play nothing.
          audio.pause();
          audio.removeAttribute('src');
          audio.load();
          toggle.disabled = true;
        }

        links.forEach((l) => {
          if (l.dataset.slug === data.slug) {
            l.setAttribute('aria-current', 'true');
          } else {
            l.removeAttribute('aria-current');
          }
        });
      }

      if (scroll) {
        const section = document.getElementById(data.slug);
        if (section) {
          const target = getSettledScrollTarget(
            section.offsetTop,
            section.offsetHeight,
            document.documentElement.clientHeight
          );
          smoothScrollTo(target);
        }
      }
    }

    function setPlayingState(isPlaying: boolean): void {
      iconPlay.classList.toggle('is-hidden', isPlaying);
      iconPause.classList.toggle('is-hidden', !isPlaying);
      toggle.setAttribute('aria-label', isPlaying ? 'Pause' : 'Play');
      toggle.setAttribute('aria-pressed', String(isPlaying));
    }

    toggle.addEventListener('click', () => {
      if (toggle.disabled || !audio.getAttribute('src')) return;
      if (audio.paused) {
        audio.play().catch(() => {});
      } else {
        audio.pause();
      }
    });

    audio.addEventListener('play', () => setPlayingState(true));
    audio.addEventListener('pause', () => setPlayingState(false));
    audio.addEventListener('ended', () => setPlayingState(false));

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const slug = link.dataset.slug ?? '';

        if (slug === currentSlug) {
          // Already the loaded track: toggle play/pause, same as the button.
          if (!toggle.disabled && audio.getAttribute('src')) {
            if (audio.paused) {
              audio.play().catch(() => {});
            } else {
              audio.pause();
            }
          }
          loadTrack(slug, { scroll: true });
        } else {
          loadTrack(slug, { scroll: true, autoplay: true });
        }
      });
    });

    // "Who We Are" drawer: the corner tab toggles a panel that slides out
    // of the player's left edge (slides up over the bottom bar on mobile).
    const aboutTab = player.querySelector<HTMLButtonElement>('[data-role="about-tab"]');
    const aboutPanel = player.querySelector<HTMLElement>('[data-role="about-panel"]');

    if (aboutTab && aboutPanel) {
      const tab = aboutTab;
      const panel = aboutPanel;

      const setAboutOpen = (open: boolean): void => {
        player.classList.toggle('about-open', open);
        tab.setAttribute('aria-expanded', String(open));
        tab.setAttribute('aria-label', open ? 'Close' : 'The Band');
        panel.setAttribute('aria-hidden', String(!open));
      };

      tab.addEventListener('click', () => {
        setAboutOpen(tab.getAttribute('aria-expanded') !== 'true');
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setAboutOpen(false);
      });
    }

    // Scrollspy: keep the player's loaded (but paused) track in sync with
    // whichever track section is centered in the viewport. Never interrupts
    // an actively playing track.
    const sections = links
      .map((link) => document.getElementById(link.dataset.slug ?? ''))
      .filter((el): el is HTMLElement => el !== null);

    if (sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!audio.paused) return;
          const visible = entries.find((entry) => entry.isIntersecting);
          if (visible?.target.id) loadTrack(visible.target.id);
        },
        { rootMargin: '-50% 0px -50% 0px', threshold: 0 }
      );

      sections.forEach((section) => observer.observe(section));
    }

    // Start pre-loaded on the newest release (first link), paused.
    loadTrack(links[0].dataset.slug ?? '');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
