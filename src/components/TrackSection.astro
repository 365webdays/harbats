---
import type { Track } from '../data/tracks';
import { platforms } from '../data/platforms';

interface Props extends Track {}

const {
  slug,
  title,
  releaseDate,
  primaryWords,
  secondaryWords,
  credits,
  description,
  artworkUrl,
  links,
  accentColor,
  secondaryAccentColor,
  minSize,
  maxSize,
  secondaryMinOpacity,
} = Astro.props;
---

<article
  class="track"
  id={slug}
  style={`--track-accent: var(--color-${accentColor}); --secondary-accent: var(--color-${secondaryAccentColor})`}
>
  <section class="hero">
    <div class="hero-sticky">
      <!-- Real heading for SEO/screen readers; the scroll-scrubbed markup
           below is purely decorative and hidden from assistive tech. -->
      <h2 class="sr-only">{title}</h2>

      <div
        class="headline"
        aria-hidden="true"
        data-min-size={minSize}
        data-max-size={maxSize}
        data-secondary-min-opacity={secondaryMinOpacity}
      >
        <div class="headline-content">
          <div class="headline-line headline-line--primary">
            {primaryWords.map((word) => (
              <span class="group"><span>{word}</span></span>
            ))}
          </div>
          <div class="headline-line headline-line--secondary">
            {secondaryWords.map((word) => (
              <span class="group"><span>{word}</span></span>
            ))}
          </div>
        </div>
      </div>

      <div class="track-description">
        {artworkUrl && (
          <img
            class="track-art"
            src={artworkUrl}
            alt={`${title} cover art`}
            loading="lazy"
          />
        )}
        <div class="track-description-text">
          <p class="track-description-eyebrow">{releaseDate}</p>
          <ul class="track-credits">
            {credits.map((credit) => (
              <li class="track-credit">
                <span class="track-credit-name">{credit.name}</span>
                <span class="track-credit-roles">{credit.roles.join(', ')}</span>
              </li>
            ))}
          </ul>
          {description && <p class="track-description-body">{description}</p>}
          {links && links.length > 0 ? (
            <div class="track-listen">
              <button
                class="track-listen-toggle"
                type="button"
                aria-expanded="false"
                aria-controls={`track-listen-popover-${slug}`}
              >
                Listen
                <svg class="track-listen-caret" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 10l5 5 5-5z" />
                </svg>
              </button>
              <div
                class="track-listen-popover"
                id={`track-listen-popover-${slug}`}
                hidden
              >
                <ul class="track-listen-list">
                  {links.map((link) => {
                    const platform = platforms[link.platform];
                    return (
                      <li>
                        <a
                          class="track-listen-link"
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <svg viewBox={platform.viewBox} aria-hidden="true">
                            {platform.paths.map((d) => (
                              <path d={d} />
                            ))}
                          </svg>
                          <span>{platform.name}</span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </div>
          ) : (
            <span class="track-listen-soon">Streaming soon</span>
          )}
        </div>
      </div>
    </div>
  </section>
</article>

<script>
  // Drives every `.hero` pinned track on the page off a single shared
  // scroll/resize listener, rather than one listener per track.
  //
  // Each track's scroll runway is split into three sequential phases:
  //   1. Headline phase   - headline shrinks (maxSize -> minSize) and the
  //                         secondary lyric line fades in
  //   2. Description phase - once the headline has settled, the description
  //                          block (stacked below it) fades/rises in
  //   3. Hold phase        - remaining scroll distance: everything stays put
  //                          (progress is already clamped at 1) while
  //                          `.hero-sticky` keeps pinning, giving a beat to
  //                          read before releasing into the next track
  import { HEADLINE_PHASE_END, DESCRIPTION_PHASE_END } from '../lib/scrollPhases';

  interface TrackInstance {
    hero: HTMLElement;
    headline: HTMLElement;
    headlineContent: HTMLElement;
    secondaryLine: HTMLElement;
    trackDescription: HTMLElement;
    minSize: number;
    maxSize: number;
    secondaryMinOpacity: number;
    heroTop: number;
    heroHeight: number;
  }

  const BASE_FONT_SIZE_VW = 12;

  const instances: TrackInstance[] = [];
  let viewportHeight = 0;

  function clamp(value: number, min: number, max: number): number {
    return Math.min(Math.max(value, min), max);
  }

  // Remaps `value` from range [start, end] to [0, 1], clamped.
  function remap(value: number, start: number, end: number): number {
    if (end <= start) return value >= end ? 1 : 0;
    return clamp((value - start) / (end - start), 0, 1);
  }

  function collectInstances(): void {
    instances.length = 0;

    document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
      const headline = hero.querySelector<HTMLElement>('.headline');
      const headlineContent = hero.querySelector<HTMLElement>('.headline-content');
      const secondaryLine = hero.querySelector<HTMLElement>('.headline-line--secondary');
      const trackDescription = hero.querySelector<HTMLElement>('.track-description');

      if (!headline || !headlineContent || !secondaryLine || !trackDescription) return;

      instances.push({
        hero,
        headline,
        headlineContent,
        secondaryLine,
        trackDescription,
        minSize: parseFloat(headline.dataset.minSize ?? '') || 0.35,
        maxSize: parseFloat(headline.dataset.maxSize ?? '') || 1.6,
        secondaryMinOpacity: parseFloat(headline.dataset.secondaryMinOpacity ?? '') || 0.06,
        heroTop: 0,
        heroHeight: 0,
      });
    });
  }

  function measure(): void {
    viewportHeight = document.documentElement.clientHeight;
    for (const instance of instances) {
      instance.heroTop = instance.hero.offsetTop;
      instance.heroHeight = instance.hero.offsetHeight;
    }
  }

  function update(): void {
    const scrollY = window.pageYOffset || document.documentElement.scrollTop;

    for (const instance of instances) {
      const scrollable = instance.heroHeight - viewportHeight;
      const progress =
        scrollable > 0 ? clamp((scrollY - instance.heroTop) / scrollable, 0, 1) : 0;

      const headlineProgress = remap(progress, 0, HEADLINE_PHASE_END);
      const descriptionProgress = remap(progress, HEADLINE_PHASE_END, DESCRIPTION_PHASE_END);

      // Shrinks as you scroll down (maxSize -> minSize), making room for
      // the secondary line beneath it to reveal itself.
      const currentSize =
        instance.maxSize - (instance.maxSize - instance.minSize) * headlineProgress;

      // Animate font-size directly (not transform: scale) so the browser
      // reflows the text and the flex-wrap container breaks it onto a new
      // line once it no longer fits within the viewport width.
      instance.headlineContent.style.fontSize = `${BASE_FONT_SIZE_VW * currentSize}vw`;

      // Secondary line fades in from barely-readable to fully visible,
      // alongside the headline shrink.
      instance.secondaryLine.style.opacity = String(
        instance.secondaryMinOpacity + (1 - instance.secondaryMinOpacity) * headlineProgress
      );

      // Once the headline has settled, the description fades/rises in.
      instance.trackDescription.style.opacity = String(descriptionProgress);
      instance.trackDescription.style.transform = `translate3d(0, ${
        (1 - descriptionProgress) * 16
      }px, 0)`;
      // Keep the (invisible) description from swallowing clicks — most
      // importantly the "Listen" popover — until it starts appearing.
      instance.trackDescription.style.pointerEvents =
        descriptionProgress > 0 ? 'auto' : 'none';
    }
  }

  function onResize(): void {
    measure();
    update();
  }

  if (!window.__scrollHeadlineBootstrapped) {
    window.__scrollHeadlineBootstrapped = true;

    // "Listen" popovers: one delegated listener drives every track's
    // toggle. Opening one closes the others; Escape or an outside click
    // closes whatever is open.
    const setPopoverOpen = (root: HTMLElement, open: boolean): void => {
      root.classList.toggle('is-open', open);
      root
        .querySelector<HTMLButtonElement>('.track-listen-toggle')
        ?.setAttribute('aria-expanded', String(open));
      root
        .querySelector<HTMLElement>('.track-listen-popover')
        ?.toggleAttribute('hidden', !open);
    };

    const closeAllPopovers = (except?: HTMLElement): void => {
      document
        .querySelectorAll<HTMLElement>('.track-listen.is-open')
        .forEach((root) => {
          if (root !== except) setPopoverOpen(root, false);
        });
    };

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const toggle = target.closest<HTMLButtonElement>('.track-listen-toggle');
      if (toggle) {
        const root = toggle.closest<HTMLElement>('.track-listen');
        if (!root) return;
        const open = !root.classList.contains('is-open');
        setPopoverOpen(root, open);
        if (open) closeAllPopovers(root);
        return;
      }
      if (!target.closest('.track-listen-popover')) closeAllPopovers();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAllPopovers();
    });

    // Scrolling fades the description (and its popover) out — close any
    // open popover so it isn't waiting, detached, on return.
    window.addEventListener('scroll', () => closeAllPopovers(), { passive: true });

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', onResize);

    window.addEventListener('load', () => {
      collectInstances();
      measure();
      update();
    });
  }

  declare global {
    interface Window {
      __scrollHeadlineBootstrapped?: boolean;
    }
  }
</script>
