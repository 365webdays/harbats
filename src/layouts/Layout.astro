---
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import MediaPlayer from '../components/MediaPlayer.astro';
import RetroRibbons from '../components/RetroRibbons.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Harbats',
  description = 'Harbats, the enigmatic band hailing from the vibrant streets of Manila, Philippines, and bringing their own flavor to the iconic Manila sound.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <link rel="canonical" href="https://harbats.com/" />

    <!-- SEO Meta Tags -->
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="OPM, Original Pilipino Music, Bernie Asis, Michael Peralta, Pakipot, Hansolo, Kumot, Meryendabol, Reyna Ng Gabi, Inaaliw, Bumuhos Ka Ulan, Sa Tuwing Gumagabi"
    />
    <meta name="author" content="Michael Peralta" />

    <!-- Open Graph -->
    <meta property="fb:app_id" content="949334456873792" />
    <meta property="og:type" content="music.song" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content="https://harbats.com/" />
    <meta property="og:image" content="https://harbats.com/assets/img/og_harbats.jpg" />
    <meta property="og:description" content={description} />
    <meta
      property="og:audio"
      content="https://open.spotify.com/artist/56pbbwP3CsijBVhENUgU7q?si=FI5goxWXTt6vkEnhTPwxBA"
    />
    <meta
      property="music:album"
      content="https://open.spotify.com/artist/56pbbwP3CsijBVhENUgU7q?si=FI5goxWXTt6vkEnhTPwxBA"
    />
    <meta property="music:musician" content="https://harbats.com/og_profile.html" />

    <!-- Viewport -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Favicon and Touch Icons -->
    <link rel="shortcut icon" href="/assets/favicon/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/assets/favicon/manifest.json" />
    <meta name="theme-color" content="#E5E5D6" />

    <!-- Google Fonts: Inter, Bold 700 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Fonts: Google Sans Code, used for the media player -->
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Code:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <RetroRibbons />

      <header class="page-nav">
        <span>Harbats</span>
        <span class="page-nav-right">
          <span class="page-nav-hint">Scroll ↓</span>
          <a href="#" class="page-nav-top">Back to top ↑</a>
        </span>
      </header>

      <slot />

      <MediaPlayer />
    </div>

    <script>
      import { initLenis } from '../lib/lenis';
      import { smoothScrollTo } from '../lib/smoothScroll';

      window.addEventListener('load', () => {
        requestAnimationFrame(() => {
          document.querySelector('.page')?.classList.add('page__ready');
        });
      });

      initLenis();

      const nav = document.querySelector('.page-nav');
      const updateNav = () => {
        nav?.classList.toggle('page-nav--scrolled', window.scrollY > window.innerHeight);
      };
      window.addEventListener('scroll', updateNav, { passive: true });
      window.addEventListener('resize', updateNav);
      updateNav();

      document.querySelector('.page-nav-top')?.addEventListener('click', (event) => {
        event.preventDefault();
        smoothScrollTo(0);
      });
    </script>
  </body>
</html>
